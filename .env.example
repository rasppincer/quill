# Quill environment variables
# Copy to .env and fill in values. .env is gitignored.

# LLM API key (for OpenAI, Anthropic, or other cloud providers)
# Leave empty for local LLMs that don't need auth
QUILL_API_KEY=

# Optional: override API base from model.yaml
# QUILL_API_BASE=http://localhost:1234/v1

# Redis broker URL for Celery workers.
# Point this at any reachable Redis instance — local or LAN.
# Examples:
#   redis://localhost:6379/0                      (local Redis, no auth)
#   redis://:mypassword@192.168.1.50:6379/0       (LAN Redis by IP, with password)
#   redis://:mypassword@redis.home.arpa:6379/0    (LAN Redis by hostname, with password)
REDIS_URL=redis://localhost:6379/0

# Set to 1 to run live Redis connectivity tests (test_redis_connectivity.py).
# Leave unset (default) to skip those tests and keep the normal suite fast.
# QUILL_TEST_REDIS_LIVE=1
